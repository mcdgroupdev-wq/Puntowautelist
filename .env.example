# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
# Used for self-referential links, unsubscribe URLs, and launch emails.
APP_URL="http://localhost:3000"

# ==============================================================================
# SUPABASE (Base de datos y Edge Functions — valores pendientes de configurar)
# ==============================================================================
# URL de tu proyecto Supabase (ej. https://xxxxxxxxxxxx.supabase.co)
SUPABASE_URL=""

# Clave pública anónima (opcional en servidor, nunca usar service_role en frontend)
SUPABASE_ANON_KEY=""

# Clave privada de servicio (SOLO servidor / Edge Functions, NUNCA en frontend)
SUPABASE_SERVICE_ROLE_KEY=""

# ==============================================================================
# SISTEMA DE CORREO DE LANZAMIENTO (Resend + seguridad de baja)
# ==============================================================================
# Clave API de Resend para el envío del correo de lanzamiento (SOLO servidor / Edge Functions)
RESEND_API_KEY=""

# Remitente verificado en Resend (ej. "Punto <hola@tudominio.com>")
RESEND_FROM_EMAIL=""

# Secreto para firmar los enlaces seguros de cancelación de suscripción (HMAC-SHA256)
UNSUBSCRIBE_SECRET=""

# Secreto de administrador para autorizar el disparo manual del envío de lanzamiento
ADMIN_LAUNCH_SECRET=""

# Correo de Google autorizado para abrir el panel de sincronización con Google Sheets
# (separar por comas si hay varios administradores; por defecto usa mcdgroup.dev@gmail.com)
ADMIN_GOOGLE_EMAIL="mcdgroup.dev@gmail.com"
